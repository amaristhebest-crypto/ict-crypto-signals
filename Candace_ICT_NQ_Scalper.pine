//@version=5
// =============================================================================
//  CANDICE LAU / CHART FANATICS — COMPLETE NQ INSTITUTIONAL SUITE [AUDITED & FIXED]
//  Combines her full Institutional Level Map with an Assisted Execution Engine.
//  
//  Audited & Patched Features:
//    1. IFVG Lifecycle Fix: Prevents IFVG deletion on birth; tracks active state.
//    2. Candice 09:28 Trade Window: Covers 09:15-11:00 ET execution window.
//    3. Extended Sweep Recency: 75-bar lookback captures 08:30 news sweeps into open.
//    4. Wired EQH / EQL Sweeps: Relative equal highs & lows directly trigger setups.
//    5. Structural Stop Loss: Pure structure SL; skips trades exceeding max risk.
//    6. Strict Minimum R:R Gate: Enforces >= i_min_rr (e.g. 2.0R minimum).
//    7. Daily RTH 50% Reset & Ordered TP1/TP2: Prevents stale gaps and inverted TPs.
//    8. Authentic 3-Candle 1H FVG: Compares candle [1] with candle [3] (not adjacent [2]).
//    9. Dynamic Contract Sizing: Sized precisely for MFFU $250 Risk Plan (MNQ).
//   10. Newest IFVG Selection: Targets the freshest active inversion zone.
// =============================================================================
indicator("Candice Lau Complete ICT Suite [Levels + Signals - Patched]", overlay=true,
     max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ---------------------------------------------------------------- INPUTS ---
gT = "Sessions & Timing (New York time)"
i_session = input.session("0915-1100:1234567", "Execution Window (Captures 09:28 Pre-Open)", group=gT)
i_asia    = input.bool(true,  "Asian range 19:00-02:00", group=gT)
i_london  = input.bool(true,  "London range 02:00-05:00", group=gT)
i_amzone  = input.bool(true,  "Highlight Execution Window on Chart", group=gT)
i_mid     = input.bool(true,  "Midnight opening price 00:00", group=gT)

gG = "Opening Gaps (Take Profit Magnets)"
i_rth     = input.bool(true,  "RTH gap (16:00 -> 09:30) + 25/50/75% scale-outs", group=gG)
i_ndog    = input.bool(true,  "New Day Opening Gap (17:00 -> 18:00)", group=gG)
i_nwog    = input.bool(true,  "New Week Opening Gap (Sun open -> Fri close)", group=gG)

gP = "PD Arrays & Gaps"
i_fvg     = input.bool(true,  "Fair Value Gaps (FVG)", group=gP)
i_ifvg    = input.bool(true,  "Inversion FVGs (IFVG Confirmation)", group=gP)
i_ce      = input.bool(true,  "Consequent Encroachment (50% CE)", group=gP)
i_h1fvg   = input.bool(true,  "1-Hour FVG HTF Targets (3-Candle ICT Model)", group=gP)
i_minfvg  = input.float(0.0,  "Min FVG size (points)", group=gP)
i_maxfvg  = input.int(20,     "Max FVGs kept in memory", minval=5, maxval=60, group=gP)

gL = "Liquidity & Sweeps"
i_pdhl    = input.bool(true,  "Previous Day High / Low", group=gL)
i_eq      = input.bool(true,  "Relative equal highs / lows (EQH / EQL)", group=gL)
i_eqtol   = input.float(2.0,  "Equal-level tolerance (points)", group=gL)
i_sweep   = input.bool(true,  "Flag sweeps of session & EQ levels", group=gL)
i_recency = input.int(75,     "Sweep recency window (bars, 75m covers 08:30 sweep)", minval=10, maxval=180, group=gL)

gS = "SMT Divergence"
i_smt     = input.bool(true,  "SMT divergence vs ES", group=gS)
i_smtsym  = input.string("CME_MINI:ES1!", "Correlated symbol", group=gS)

gE = "Assisted Execution & Tradovate Sizing"
i_signals   = input.bool(true,  "Show A+ Assisted Signals (Entry / SL / TP)", group=gE)
i_min_rr    = input.float(2.0,  "Minimum Target R:R Ratio", step=0.5, group=gE)
i_max_sl    = input.float(35.0, "Max Allowed Structural SL (Points, reject if > max)", group=gE)
i_risk_mode = input.string("MFFU $250 Risk Plan", "Position Sizing", options=["MFFU $250 Risk Plan", "Fixed 2 MNQ"], group=gE)
i_risk_cash = input.float(250.0, "Target Dollar Risk ($)", group=gE)

// ---------------------------------------------------------------- COLOURS --
c_mid   = #f59e0b
c_rth   = #eab308
c_ndog  = #a78bfa
c_nwog  = #f472b6
c_asia  = #6366f1
c_lon   = #06b6d4
c_bull  = #10b981
c_bear  = #ef4444
c_ifvg_b = #06b6d4 // Cyan
c_ifvg_s = #d946ef // Magenta

// ---------------------------------------------------------------- SESSIONS -
t_asia   = not na(time(timeframe.period, "1900-0200:1234567", "America/New_York"))
t_london = not na(time(timeframe.period, "0200-0500:1234567", "America/New_York"))
t_exec   = not na(time(timeframe.period, i_session, "America/New_York"))
t_mid    = not na(time(timeframe.period, "0000-0001:1234567", "America/New_York"))
t_930    = not na(time(timeframe.period, "0930-0931:1234567", "America/New_York"))
t_1600   = not na(time(timeframe.period, "1600-1601:1234567", "America/New_York"))
t_1700   = not na(time(timeframe.period, "1700-1701:1234567", "America/New_York"))
t_1800   = not na(time(timeframe.period, "1800-1801:1234567", "America/New_York"))

bgcolor(i_amzone and t_exec ? color.new(c_bull, 94) : na, title="Execution Window Background")

newDay = ta.change(dayofmonth(time("D", "0000-0005", "America/New_York"))) != 0

// ------------------------------------------------- 1. MIDNIGHT OPENING PRICE
var float midOpen = na
if t_mid and not t_mid[1]
    midOpen := open
plot(i_mid and not na(midOpen) ? midOpen : na, "Midnight Open",
     color=c_mid, linewidth=2, style=plot.style_linebr)

// ------------------------------------------------------------- 2. RTH GAP --
var float rthPrevClose = na
var float rthOpen      = na
var float rth50        = na
var box   rthBox       = na
var line  l25 = na, var line l50 = na, var line l75 = na

if t_1600 and not t_1600[1]
    rthPrevClose := close

// FIX 5: Reset rth50 and old lines at 09:30 so days without gaps don't carry stale levels
if t_930 and not t_930[1]
    rth50 := na
    rthOpen := open
    if i_rth and not na(rthPrevClose) and math.abs(rthOpen - rthPrevClose) > syminfo.mintick
        float hi = math.max(rthOpen, rthPrevClose)
        float lo = math.min(rthOpen, rthPrevClose)
        rthBox := box.new(bar_index, hi, bar_index + 60, lo,
             border_color=color.new(c_rth, 30), bgcolor=color.new(c_rth, 90),
             border_style=line.style_dashed)
        label.new(bar_index, hi, "RTH GAP (" + str.tostring(math.abs(rthOpen - rthPrevClose), "#.##") + " pts)",
             color=color.new(c_rth, 20), textcolor=color.black,
             size=size.tiny, style=label.style_label_down)
        float d = rthPrevClose - rthOpen
        rth50 := rthOpen + d * 0.50
        l25 := line.new(bar_index, rthOpen + d * 0.25, bar_index + 60, rthOpen + d * 0.25, color=color.new(c_rth, 45), style=line.style_dotted)
        l50 := line.new(bar_index, rth50, bar_index + 60, rth50, color=color.new(c_rth, 20), style=line.style_dashed, width=1)
        l75 := line.new(bar_index, rthOpen + d * 0.75, bar_index + 60, rthOpen + d * 0.75, color=color.new(c_rth, 45), style=line.style_dotted)

if not na(rthBox)
    box.set_right(rthBox, bar_index + 5)
    line.set_x2(l25, bar_index + 5)
    line.set_x2(l50, bar_index + 5)
    line.set_x2(l75, bar_index + 5)

// --------------------------------------------- 3. NDOG / NWOG OPENING GAPS --
var float pre1700 = na
var box ndogBox = na, var box nwogBox = na

if t_1700 and not t_1700[1]
    pre1700 := close

if t_1800 and not t_1800[1] and not na(pre1700)
    bool isSunday = dayofweek(time, "America/New_York") == dayofweek.sunday
    if math.abs(open - pre1700) > syminfo.mintick
        float hi = math.max(open, pre1700)
        float lo = math.min(open, pre1700)
        if isSunday and i_nwog
            nwogBox := box.new(bar_index, hi, bar_index + 200, lo, border_color=color.new(c_nwog, 20), bgcolor=color.new(c_nwog, 88))
            label.new(bar_index, hi, "NWOG", color=color.new(c_nwog, 20), textcolor=color.white, size=size.tiny, style=label.style_label_down)
        else if i_ndog
            ndogBox := box.new(bar_index, hi, bar_index + 120, lo, border_color=color.new(c_ndog, 25), bgcolor=color.new(c_ndog, 90))
            label.new(bar_index, hi, "NDOG", color=color.new(c_ndog, 25), textcolor=color.white, size=size.tiny, style=label.style_label_down)

if not na(ndogBox)
    box.set_right(ndogBox, bar_index + 5)
if not na(nwogBox)
    box.set_right(nwogBox, bar_index + 5)

// ----------------------------------------------------- 4. PREVIOUS DAY H/L --
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
plot(i_pdhl ? pdh : na, "PDH", color=color.new(c_bear, 35), style=plot.style_linebr)
plot(i_pdhl ? pdl : na, "PDL", color=color.new(c_bull, 35), style=plot.style_linebr)

// ------------------------------------------------- 5. ASIA / LONDON RANGES --
var float aH = na, var float aL = na
var float lH = na, var float lL = na
var box aBox = na, var box lBox = na
var int aHswBar = 0, var int aLswBar = 0
var int lHswBar = 0, var int lLswBar = 0

if t_asia and not t_asia[1]
    aH := high, aL := low, aHswBar := 0, aLswBar := 0
    if i_asia
        aBox := box.new(bar_index, aH, bar_index, aL, border_color=color.new(c_asia, 40), bgcolor=color.new(c_asia, 92))
else if t_asia
    aH := math.max(aH, high), aL := math.min(aL, low)
    if i_asia and not na(aBox)
        box.set_top(aBox, aH), box.set_bottom(aBox, aL), box.set_right(aBox, bar_index)
else if i_asia and not na(aBox) and not newDay
    box.set_right(aBox, bar_index)

if t_london and not t_london[1]
    lH := high, lL := low, lHswBar := 0, lLswBar := 0
    if i_london
        lBox := box.new(bar_index, lH, bar_index, lL, border_color=color.new(c_lon, 40), bgcolor=color.new(c_lon, 92))
else if t_london
    lH := math.max(lH, high), lL := math.min(lL, low)
    if i_london and not na(lBox)
        box.set_top(lBox, lH), box.set_bottom(lBox, lL), box.set_right(lBox, bar_index)
else if i_london and not na(lBox) and not newDay
    box.set_right(lBox, bar_index)

// ------------------------------------------- 6. RELATIVE EQUAL HIGHS / LOWS-
ph = ta.pivothigh(high, 3, 3)
pl = ta.pivotlow(low, 3, 3)
var float lastPH = na, var int lastPHb = na
var float lastPL = na, var int lastPLb = na
var float active_eqh = na, var float active_eql = na
var int   eqh_sw_bar = 0,  var int   eql_sw_bar = 0

if not na(ph)
    if i_eq and not na(lastPH) and math.abs(ph - lastPH) <= i_eqtol
        active_eqh := ph
        line.new(lastPHb, lastPH, bar_index - 3, ph, color=color.new(c_bear, 10), width=2, extend=extend.right, style=line.style_dotted)
        label.new(bar_index - 3, ph, "EQH (Buy-side Liquidity Pool)", color=color.new(c_bear, 30), textcolor=color.white, size=size.tiny, style=label.style_label_down)
    lastPH := ph, lastPHb := bar_index - 3

if not na(pl)
    if i_eq and not na(lastPL) and math.abs(pl - lastPL) <= i_eqtol
        active_eql := pl
        line.new(lastPLb, lastPL, bar_index - 3, pl, color=color.new(c_bull, 10), width=2, extend=extend.right, style=line.style_dotted)
        label.new(bar_index - 3, pl, "EQL (Sell-side Liquidity Pool)", color=color.new(c_bull, 30), textcolor=color.white, size=size.tiny, style=label.style_label_up)
    lastPL := pl, lastPLb := bar_index - 3

// Sweep tracking (Asia, London, AND Equal Highs/Lows)
if i_sweep and barstate.isconfirmed
    if not na(aH) and aHswBar == 0 and not t_asia and high > aH
        aHswBar := bar_index
        label.new(bar_index, high, "Asia High swept", color=color.new(c_bear, 25), textcolor=color.white, size=size.tiny, style=label.style_label_down)
    if not na(aL) and aLswBar == 0 and not t_asia and low < aL
        aLswBar := bar_index
        label.new(bar_index, low, "Asia Low swept", color=color.new(c_bull, 25), textcolor=color.white, size=size.tiny, style=label.style_label_up)
    if not na(lH) and lHswBar == 0 and not t_london and high > lH
        lHswBar := bar_index
        label.new(bar_index, high, "London High swept", color=color.new(c_bear, 15), textcolor=color.white, size=size.tiny, style=label.style_label_down)
    if not na(lL) and lLswBar == 0 and not t_london and low < lL
        lLswBar := bar_index
        label.new(bar_index, low, "London Low swept", color=color.new(c_bull, 15), textcolor=color.white, size=size.tiny, style=label.style_label_up)
    // FIX 2: Wire Equal Highs / Equal Lows sweeps directly into execution triggers
    if not na(active_eql) and eql_sw_bar == 0 and low < active_eql
        eql_sw_bar := bar_index
        label.new(bar_index, low, "EQL Swept", color=color.new(c_bull, 20), textcolor=color.white, size=size.tiny, style=label.style_label_up)
    if not na(active_eqh) and eqh_sw_bar == 0 and high > active_eqh
        eqh_sw_bar := bar_index
        label.new(bar_index, high, "EQH Swept", color=color.new(c_bear, 20), textcolor=color.white, size=size.tiny, style=label.style_label_down)

// Reset sweeps on new day
if newDay
    eql_sw_bar := 0
    eqh_sw_bar := 0

bool recent_low_sweep = (aLswBar > 0 and (bar_index - aLswBar) <= i_recency) or 
                         (lLswBar > 0 and (bar_index - lLswBar) <= i_recency) or 
                         (eql_sw_bar > 0 and (bar_index - eql_sw_bar) <= i_recency)

bool recent_high_sweep = (aHswBar > 0 and (bar_index - aHswBar) <= i_recency) or 
                          (lHswBar > 0 and (bar_index - lHswBar) <= i_recency) or 
                          (eqh_sw_bar > 0 and (bar_index - eqh_sw_bar) <= i_recency)

// ------------------------------------------------------------- 7. FVGs & IFVG-
var float[] fTop  = array.new_float()
var float[] fBot  = array.new_float()
var bool[]  fBull = array.new_bool()
var box[]   fBox  = array.new_box()
var line[]  fCE   = array.new_line()
var bool[]  fInv  = array.new_bool()

bullGap = low > high[2] and (low - high[2]) >= i_minfvg
bearGap = high < low[2] and (low[2] - high) >= i_minfvg

if i_fvg and (bullGap or bearGap) and barstate.isconfirmed
    float t = bullGap ? low : low[2]
    float b = bullGap ? high[2] : high
    color cc = bullGap ? c_bull : c_bear
    box nb = box.new(bar_index - 2, t, bar_index + 12, b, border_color=color.new(cc, 55), bgcolor=color.new(cc, 85))
    line nl = i_ce ? line.new(bar_index - 2, (t + b) / 2, bar_index + 12, (t + b) / 2, color=color.new(#ffffff, 55), style=line.style_dotted) : na
    array.push(fTop, t), array.push(fBot, b), array.push(fBull, bullGap)
    array.push(fBox, nb), array.push(fCE, nl), array.push(fInv, false)

// Track active IFVGs for execution signals (Point 8: Target freshest/newest active IFVG)
float active_bull_ifvg_ce = na
float active_bull_ifvg_bot = na
float active_bear_ifvg_ce = na
float active_bear_ifvg_top = na

if array.size(fBox) > 0
    // Iterate from newest (size - 1) to oldest (0)
    for i = array.size(fBox) - 1 to 0
        float t = array.get(fTop, i)
        float b = array.get(fBot, i)
        bool  u = array.get(fBull, i)
        bool  inv = array.get(fInv, i)

        // Check for Inversion if not yet inverted
        if not inv and i_ifvg
            if not u and close > t // Bearish FVG inverted upward to Bullish Support
                array.set(fInv, i, true)
                box.set_bgcolor(array.get(fBox, i), color.new(c_ifvg_b, 80))
                box.set_border_color(array.get(fBox, i), color.new(c_ifvg_b, 30))
                label.new(bar_index, t, "Bullish IFVG (Support)", color=color.new(c_ifvg_b, 20), textcolor=color.white, size=size.tiny, style=label.style_label_down)
            else if u and close < b // Bullish FVG inverted downward to Bearish Resistance
                array.set(fInv, i, true)
                box.set_bgcolor(array.get(fBox, i), color.new(c_ifvg_s, 80))
                box.set_border_color(array.get(fBox, i), color.new(c_ifvg_s, 30))
                label.new(bar_index, b, "Bearish IFVG (Resistance)", color=color.new(c_ifvg_s, 20), textcolor=color.white, size=size.tiny, style=label.style_label_up)

        // FIX 1: Re-read inv state so fresh inversions are NOT deleted on the birth bar!
        bool current_inv = array.get(fInv, i)
        bool dead = false

        if current_inv
            // An inverted FVG dies only when violated on the other side
            // Bullish IFVG (originally bearish u=false) acts as support: dies if close < b
            // Bearish IFVG (originally bullish u=true) acts as resistance: dies if close > t
            dead := (not u and close < b) or (u and close > t)
            if not dead
                // Point 8: Store the NEWEST active IFVG (first encountered in reverse loop)
                if not u and na(active_bull_ifvg_ce)
                    active_bull_ifvg_ce := (t + b) / 2.0
                    active_bull_ifvg_bot := b
                else if u and na(active_bear_ifvg_ce)
                    active_bear_ifvg_ce := (t + b) / 2.0
                    active_bear_ifvg_top := t
        else
            // Regular uninverted FVG dies if price fills it through without inversion mode
            if not i_ifvg
                dead := (u and close < b) or (not u and close > t)

        if dead or (array.size(fBox) > i_maxfvg and i == 0)
            box.delete(array.get(fBox, i))
            line lc = array.get(fCE, i)
            if not na(lc)
                line.delete(lc)
            array.remove(fTop, i), array.remove(fBot, i), array.remove(fBull, i)
            array.remove(fBox, i), array.remove(fCE, i), array.remove(fInv, i)
        else
            box.set_right(array.get(fBox, i), bar_index + 3)
            line lc2 = array.get(fCE, i)
            if not na(lc2)
                line.set_x2(lc2, bar_index + 3)

// ------------------------------------------------------------ 8. 1H FVG ----
// FIX 6: True ICT 3-Candle FVG comparing Candle [1] against Candle [3] (not adjacent [2])
[h1h3, h1l3] = request.security(syminfo.tickerid, "60", [high[3], low[3]])
[h1h1, h1l1] = request.security(syminfo.tickerid, "60", [high[1], low[1]])

var box h1Box = na
newH1 = ta.change(time("60")) != 0
if i_h1fvg and newH1 and not na(h1h3)
    bool hb = h1l1 > h1h3 // Gap between candle 1 low and candle 3 high
    bool hs = h1h1 < h1l3 // Gap between candle 1 high and candle 3 low
    if hb or hs
        float t = hb ? h1l1 : h1h3
        float b = hb ? h1h3 : h1h1
        color cc = hb ? c_bull : c_bear
        h1Box := box.new(bar_index, t, bar_index + 90, b, border_color=color.new(cc, 15), bgcolor=color.new(cc, 90), border_style=line.style_dashed, border_width=2)
        label.new(bar_index, t, hb ? "1H Bullish FVG (Target)" : "1H Bearish FVG (Target)", color=color.new(cc, 25), textcolor=color.white, size=size.tiny)
if not na(h1Box)
    box.set_right(h1Box, bar_index + 5)

// ------------------------------------------------------------- 9. SMT vs ES-
es_l = request.security(i_smtsym, timeframe.period, low)
es_h = request.security(i_smtsym, timeframe.period, high)
var string smtTxt = "—"
if i_smt and barstate.isconfirmed
    bool nqLL = low < ta.lowest(low, 20)[1]
    bool esLL = es_l < ta.lowest(es_l, 20)[1]
    bool nqHH = high > ta.highest(high, 20)[1]
    bool esHH = es_h > ta.highest(es_h, 20)[1]
    if nqLL and not esLL
        smtTxt := "BULLISH (NQ LL, ES held)"
        label.new(bar_index, low, "SMT Bullish\n(NQ LL / ES held)", color=color.new(c_bull, 20), textcolor=color.white, size=size.tiny, style=label.style_label_up)
    else if nqHH and not esHH
        smtTxt := "BEARISH (NQ HH, ES held)"
        label.new(bar_index, high, "SMT Bearish\n(NQ HH / ES held)", color=color.new(c_bear, 20), textcolor=color.white, size=size.tiny, style=label.style_label_down)

// =============================================================================
// 10. CANDICE A+ ASSISTED EXECUTION SIGNALS (WITH CLEAR ENTRY / SL / TP BOXES)
// =============================================================================
// FIX 2: Use i_session (09:15-11:00) so Candice's 09:28 trade is fully covered
bool in_window   = t_exec
bool is_discount = not na(midOpen) and close < midOpen
bool is_premium  = not na(midOpen) and close > midOpen

bool buy_trigger  = i_signals and in_window and recent_low_sweep and is_discount and not na(active_bull_ifvg_ce) and barstate.isconfirmed
bool sell_trigger = i_signals and in_window and recent_high_sweep and is_premium and not na(active_bear_ifvg_ce) and barstate.isconfirmed

var int last_sig_bar = 0

// BUY SETUP EXECUTION
if buy_trigger and (bar_index - last_sig_bar > 15)
    float entry_px = active_bull_ifvg_ce
    // FIX 3: Structural Stop behind IFVG bottom. Do NOT shrink stop arbitrarily; enforce true risk
    float sl_px    = active_bull_ifvg_bot - (syminfo.mintick * 6)
    float risk_pts = entry_px - sl_px

    // FIX 3: If structural risk exceeds i_max_sl, SKIP the trade rather than taking random noise
    if risk_pts > 0 and risk_pts <= i_max_sl
        // Target calculation
        float tp2_raw = not na(lH) and lH > entry_px ? lH : (not na(pdh) and pdh > entry_px ? pdh : entry_px + (risk_pts * i_min_rr))
        float tp2_px  = math.max(tp2_raw, entry_px + (risk_pts * i_min_rr))
        
        // FIX 4: Minimum R:R check must actually enforce i_min_rr
        bool rr_valid = (tp2_px - entry_px) / risk_pts >= i_min_rr

        // FIX 5: TP1 ordering - must land strictly between entry and TP2
        float tp1_px = not na(rth50) and rth50 > entry_px and rth50 < tp2_px ? rth50 : entry_px + (risk_pts * 1.0)

        if rr_valid
            last_sig_bar := bar_index

            // Sizing: MFFU $250 Plan vs Fixed 2 MNQ (Point 7)
            int contracts = i_risk_mode == "Fixed 2 MNQ" ? 2 : math.max(1, math.floor(i_risk_cash / (risk_pts * 2.0)))
            float dollar_risk = contracts * (risk_pts * 2.0)
            float dollar_tp1  = (contracts / 2.0) * ((tp1_px - entry_px) * 2.0)
            float dollar_tp2  = (contracts / 2.0) * ((tp2_px - entry_px) * 2.0) + dollar_tp1

            // Draw Execution Visual Brackets
            line.new(bar_index, entry_px, bar_index + 20, entry_px, color=#38bdf8, width=2)
            line.new(bar_index, sl_px, bar_index + 20, sl_px, color=#ef4444, width=2)
            line.new(bar_index, tp1_px, bar_index + 20, tp1_px, color=#facc15, width=1, style=line.style_dashed)
            line.new(bar_index, tp2_px, bar_index + 20, tp2_px, color=#34d399, width=2)

            string txt = "⚡ CANDACE A+ BUY (LONG)\n" +
                         "--------------------\n" +
                         "Position: " + str.tostring(contracts) + " MNQ contracts\n" +
                         "1. Entry (CE Limit): $" + str.tostring(entry_px, "#.##") + "\n" +
                         "2. Stop Loss (Structure): $" + str.tostring(sl_px, "#.##") + " (" + str.tostring(risk_pts, "#.#") + " pts | -$" + str.tostring(dollar_risk, "#.##") + ")\n" +
                         "3. TP 1 (Scale 50%): $" + str.tostring(tp1_px, "#.##") + " (+$" + str.tostring(dollar_tp1, "#.##") + ")\n" +
                         "4. TP 2 (Target): $" + str.tostring(tp2_px, "#.##") + " (" + str.tostring((tp2_px - entry_px)/risk_pts, "#.#") + "R | +$" + str.tostring(dollar_tp2, "#.##") + ")"

            label.new(bar_index, low - (syminfo.mintick * 12), txt, color=color.new(#064e3b, 10), textcolor=color.white, style=label.style_label_up, size=size.small)
            alert("Candace A+ BUY | Entry: " + str.tostring(entry_px) + " | SL: " + str.tostring(sl_px) + " | TP2: " + str.tostring(tp2_px), alert.freq_once_per_bar_close)

// SELL SETUP EXECUTION
if sell_trigger and (bar_index - last_sig_bar > 15)
    float entry_px = active_bear_ifvg_ce
    // FIX 3: Structural Stop above IFVG top. Do NOT shrink stop arbitrarily
    float sl_px    = active_bear_ifvg_top + (syminfo.mintick * 6)
    float risk_pts = sl_px - entry_px

    // FIX 3: If structural risk exceeds i_max_sl, SKIP the trade rather than taking random noise
    if risk_pts > 0 and risk_pts <= i_max_sl
        // Target calculation
        float tp2_raw = not na(lL) and lL < entry_px ? lL : (not na(pdl) and pdl < entry_px ? pdl : entry_px - (risk_pts * i_min_rr))
        float tp2_px  = math.min(tp2_raw, entry_px - (risk_pts * i_min_rr))

        // FIX 4: Minimum R:R check must actually enforce i_min_rr
        bool rr_valid = (entry_px - tp2_px) / risk_pts >= i_min_rr

        // FIX 5: TP1 ordering - must land strictly between entry and TP2
        float tp1_px = not na(rth50) and rth50 < entry_px and rth50 > tp2_px ? rth50 : entry_px - (risk_pts * 1.0)

        if rr_valid
            last_sig_bar := bar_index

            // Sizing: MFFU $250 Plan vs Fixed 2 MNQ (Point 7)
            int contracts = i_risk_mode == "Fixed 2 MNQ" ? 2 : math.max(1, math.floor(i_risk_cash / (risk_pts * 2.0)))
            float dollar_risk = contracts * (risk_pts * 2.0)
            float dollar_tp1  = (contracts / 2.0) * ((entry_px - tp1_px) * 2.0)
            float dollar_tp2  = (contracts / 2.0) * ((entry_px - tp2_px) * 2.0) + dollar_tp1

            // Draw Execution Visual Brackets
            line.new(bar_index, entry_px, bar_index + 20, entry_px, color=#38bdf8, width=2)
            line.new(bar_index, sl_px, bar_index + 20, sl_px, color=#ef4444, width=2)
            line.new(bar_index, tp1_px, bar_index + 20, tp1_px, color=#facc15, width=1, style=line.style_dashed)
            line.new(bar_index, tp2_px, bar_index + 20, tp2_px, color=#34d399, width=2)

            string txt = "⚡ CANDACE A+ SELL (SHORT)\n" +
                         "--------------------\n" +
                         "Position: " + str.tostring(contracts) + " MNQ contracts\n" +
                         "1. Entry (CE Limit): $" + str.tostring(entry_px, "#.##") + "\n" +
                         "2. Stop Loss (Structure): $" + str.tostring(sl_px, "#.##") + " (" + str.tostring(risk_pts, "#.#") + " pts | -$" + str.tostring(dollar_risk, "#.##") + ")\n" +
                         "3. TP 1 (Scale 50%): $" + str.tostring(tp1_px, "#.##") + " (+$" + str.tostring(dollar_tp1, "#.##") + ")\n" +
                         "4. TP 2 (Target): $" + str.tostring(tp2_px, "#.##") + " (" + str.tostring((entry_px - tp2_px)/risk_pts, "#.#") + "R | +$" + str.tostring(dollar_tp2, "#.##") + ")"

            label.new(bar_index, high + (syminfo.mintick * 12), txt, color=color.new(#7f1d1d, 10), textcolor=color.white, style=label.style_label_down, size=size.small)
            alert("Candace A+ SELL | Entry: " + str.tostring(entry_px) + " | SL: " + str.tostring(sl_px) + " | TP2: " + str.tostring(tp2_px), alert.freq_once_per_bar_close)

// ------------------------------------------------------------- 11. HUD -----
var table hud = table.new(position.top_right, 2, 10,
     bgcolor=color.new(#0b0e14, 8), border_color=color.new(#1e293b, 0), border_width=1)

f_cell(r, k, v, cv) =>
    table.cell(hud, 0, r, k, text_color=#cbd5e1, text_size=size.small, text_halign=text.halign_left)
    table.cell(hud, 1, r, v, text_color=cv, text_size=size.small, text_halign=text.halign_right)

if barstate.islast
    table.cell(hud, 0, 0, "CANDACE SCALPING SUITE", text_color=#f8fafc, text_size=size.small)
    table.cell(hud, 1, 0, syminfo.ticker, text_color=#38bdf8, text_size=size.small, text_halign=text.halign_right)
    f_cell(1, "Midnight Open (00:00 ET)", na(midOpen) ? "—" : str.tostring(midOpen, "#.##"), #fbbf24)
    f_cell(2, "Dealing Bias (vs Midnight)", na(midOpen) ? "—" : (close < midOpen ? "🟢 DISCOUNT (Bullish)" : "🔴 PREMIUM (Bearish)"), na(midOpen) ? #94a3b8 : (close < midOpen ? #34d399 : #f87171))
    f_cell(3, "RTH Gap 50% TP", na(rth50) ? "—" : str.tostring(rth50, "#.##"), #eab308)
    f_cell(4, "Asian High", na(aH) ? "—" : str.tostring(aH, "#.##") + (aHswBar > 0 ? " ⚡ SWEPT" : " 🎯 UNTAKEN"), aHswBar > 0 ? #f87171 : #818cf8)
    f_cell(5, "Asian Low", na(aL) ? "—" : str.tostring(aL, "#.##") + (aLswBar > 0 ? " ⚡ SWEPT" : " 🎯 UNTAKEN"), aLswBar > 0 ? #f87171 : #818cf8)
    f_cell(6, "London High", na(lH) ? "—" : str.tostring(lH, "#.##") + (lHswBar > 0 ? " ⚡ SWEPT" : " 🎯 UNTAKEN"), lHswBar > 0 ? #f87171 : #22d3ee)
    f_cell(7, "London Low", na(lL) ? "—" : str.tostring(lL, "#.##") + (lLswBar > 0 ? " ⚡ SWEPT" : " 🎯 UNTAKEN"), lLswBar > 0 ? #f87171 : #22d3ee)
    f_cell(8, "SMT vs ES", smtTxt, smtTxt == "—" ? #94a3b8 : #34d399)
    string win_txt = t_exec ? "🟢 EXECUTION WINDOW (09:15-11:00)" : "⚪ Outside Window"
    color win_col = t_exec ? #34d399 : #94a3b8
    f_cell(9, "Trading Window", win_txt, win_col)
